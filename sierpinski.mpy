size = 20
row = 0

while row < size:
    col = 0
    while col <= row:
        a = col
        b = row - col
        common = 0

        while 0 < a:
            ra = a
            qa = 0
            while 2 <= ra:
                ra = ra - 2
                qa = qa + 1

            rb = b
            qb = 0
            while 2 <= rb:
                rb = rb - 2
                qb = qb + 1

            common = 0 < common + (ra == 1) * (rb == 1)

            a = qa
            b = qb

        out(35 - common * 3)

        col = col + 1

    out(10)
    row = row + 1
